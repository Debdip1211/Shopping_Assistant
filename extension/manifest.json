{
  "manifest_version": 3,
  "name": "Shopping Assistant",
  "version": "0.1.0",
  "description": "Chat about the product you're viewing on Amazon, Flipkart and other shops, and compare products you've viewed.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": [
        "content/extractors/common.js",
        "content/extractors/amazon.js",
        "content/extractors/flipkart.js",
        "content/extractors/generic.js",
        "content/highlight.js",
        "content/content.js"
      ],
      "css": ["content/content.css"]
    }
  ],
  "action": {
    "default_title": "Open Shopping Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
