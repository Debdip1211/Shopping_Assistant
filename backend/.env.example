# Copy this file to .env (same folder) and fill in your real values.
# .env is gitignored — never commit it.

# --- LLM (the model that writes answers) ---
# Which provider llm.py should use. Only "huggingface" is supported.
LLM_PROVIDER=huggingface
# Hugging Face model ID of the chat model (must be served by an Inference Provider).
# Use a non-"thinking" model. Previously used: meta-llama/Llama-3.1-8B-Instruct
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Your Hugging Face access token (starts with "hf_"). Keep it secret.
LLM_API_KEY=hf_your_token_here
# Maximum number of tokens the LLM may generate per answer (saves credits).
LLM_MAX_TOKENS=512
# Which company's server runs the model (same model, different price):
# cheapest | fastest | preferred | a provider name (e.g. deepinfra).
LLM_ROUTING=cheapest

# --- Embeddings (run locally, free) ---
# Sentence-transformers model that turns text into vectors.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Modes and chunking ---
# Products with at most this many characters of section text use full_context mode.
FULL_CONTEXT_CHAR_LIMIT=12000
# Maximum characters in one chunk body.
CHUNK_SIZE=800
# Characters shared between neighbouring chunks so ideas aren't cut in half.
CHUNK_OVERLAP=100

# --- Retrieval ---
# Chunks retrieved for "This product" questions.
CURRENT_TOP_K=5
# Chunks retrieved per product for "All viewed products" questions.
PER_PRODUCT_K=2
# How many of the most recently viewed products cross-product questions consider.
MAX_COMPARE_PRODUCTS=8

# --- Limits ---
# How many recent chat messages are sent to the LLM as history.
MAX_HISTORY_MESSAGES=6
# Maximum total characters accepted for one product (larger → HTTP 413).
MAX_PRODUCT_CHARS=300000

# --- Storage ---
# Folder for Chroma and products.json (relative paths are relative to backend/).
DATA_DIR=./data
